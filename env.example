#--------------------------------------------------------------------
# KPSTA environment configuration
#--------------------------------------------------------------------
# Copy this file to `.env` and fill in the values for the machine it
# runs on. `.env` is gitignored -- no credential belongs in the repo.
#
# On cPanel these can also be set as real environment variables; CI4
# reads either.
#--------------------------------------------------------------------

# 'production' on the live site, 'development' locally.
CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
# Must end with a trailing slash. Leave blank to auto-detect from the
# request, which is what the CI3 build did.
app.baseURL = ''
app.indexPage = ''

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = 
database.default.username = 
database.default.password = 
database.default.DBDriver = MySQLi
database.default.port = 3306

# The membership module's group. Points at the same schema as `default`
# unless it is split out.
database.membership.hostname = localhost
database.membership.database = 
database.membership.username = 
database.membership.password = 
database.membership.DBDriver = MySQLi
database.membership.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------
# Generate with: php spark key:generate
encryption.key = 

#--------------------------------------------------------------------
# OUTGOING MAIL
#--------------------------------------------------------------------
# Full DSN, e.g. smtp://user%40gmail.com:app-password@smtp.gmail.com:587
# Reserved characters must be percent-encoded (@ -> %40).
mail.dsn = 
mail.from = kpsta.in@gmail.com
mail.fromName = 'KPSTA Website'
mail.to = kpsta.in@gmail.com

#--------------------------------------------------------------------
# reCAPTCHA (admin/membership login)
#--------------------------------------------------------------------
recaptcha.siteKey = 
recaptcha.secret = 

#--------------------------------------------------------------------
# WhatsApp OTP Authentication (MSG91)
#--------------------------------------------------------------------
WHATSAPP_PROVIDER = msg91
WHATSAPP_AUTH_KEY = 
WHATSAPP_API_URL = https://api.msg91.com/api/v5/whatsapp/whatsapp-outbound-message/bulk/
WHATSAPP_INTEGRATED_NUMBER = 15559636218
WHATSAPP_FALLBACK_NUMBER = 15554929613
WHATSAPP_TEMPLATE_NAME = kpsta
