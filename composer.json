{
	"description": "KPSTA website",
	"name": "kpsta/website",
	"type": "project",
	"license": "MIT",
	"require": {
		"php": "^8.2",
		"codeigniter4/framework": "^4.7",
		"symfony/mailer": "^6.4",
		"tecnickcom/tcpdf": "^6.11"
	},
	"require-dev": {
		"mikey179/vfsstream": "^1.6",
		"phpunit/phpunit": "^11.5"
	},
	"autoload": {
		"psr-4": {
			"App\\": "app/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Tests\\Support\\": "tests/_support/"
		}
	},
	"config": {
		"optimize-autoloader": true,
		"sort-packages": true
	},
	"scripts": {
		"test": "phpunit"
	}
}
